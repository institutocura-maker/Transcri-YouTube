# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editores / SO
.DS_Store
Thumbs.db
~$*.docx
~$*.xlsx

# Artefatos de CI e logs
*.log
qa.json

# Regeneráveis pelo motor (Plano de Organização §7 e Princípio P8)
transcricoes/**/10-diagnostico/diagnostico.json

# Mídia pesada: nunca no repositório comum (Princípio P9).
# Áudio só entraria via Git LFS — as regras estão no .gitattributes.
*.mp4
*.mkv
*.avi
*.mov
*.wav
*.flac

# Zona de trânsito do Comandante: caixa de entrada, não arquivo permanente.
# O que for aprovado migra para transcricoes/<slug>/00-fonte/ e passa a ser versionado
# (metadados.yaml com sha256, fiscalizado pelo QA G1). Ver upload/README.md.
/upload/*
!/upload/README.md
